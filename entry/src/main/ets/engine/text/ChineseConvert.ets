const S2T: Map<string, string> = new Map<string, string>();
const T2S: Map<string, string> = new Map<string, string>();

for (let i = 0; i < PAIRS.length; i++) {
  const pair: string = PAIRS[i];
  const s: string = pair.substring(0, 1);
  const t: string = pair.substring(1, 2);
  // 先出现的优先（保证表里没有重复简/繁字时的一一对应）
  if (!S2T.has(s)) {
    S2T.set(s, t);
  }
  if (!T2S.has(t)) {
    T2S.set(t, s);
  }
}

function convert(text: string, table: Map<string, string>): string {
  if (text.length === 0) {
    return text;
  }
  let out: string = '';
  for (let i = 0; i < text.length; i++) {
    const ch: string = text.substring(i, i + 1);
    const mapped: string | undefined = table.get(ch);
    out += mapped === undefined ? ch : mapped;
  }
  return out;
}

/** 简体 → 繁体 */
export function toTraditional(text: string): string {
  return convert(text, S2T);
}

/** 繁体 → 简体 */
export function toSimplified(text: string): string {
  return convert(text, T2S);
}

/** 按模式转换：'off' 原样，'t2s' 繁转简，'s2t' 简转繁 */
export function convertByMode(text: string, mode: string): string {
  if (mode === 's2t') {
    return toTraditional(text);
  }
  if (mode === 't2s') {
    return toSimplified(text);
  }
  return text;
}
