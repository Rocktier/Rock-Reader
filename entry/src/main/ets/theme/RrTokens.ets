/**
 * Rock阅读 UI 层视觉 token —— 字阶 / 间距阶 / 圆角阶
 *
 * ⚠️ 本文件是 `docs/v1-design.md` §8「UI 层字阶 / 间距 / 圆角」那张表的**代码侧镜像**。
 *   **表是唯一真源，改数值先改文档再改这里** —— 两者不一致就是设计出了两个真源。
 *
 * 为什么要有这个文件（2026-10-09 建立）：
 *   审计实测 UI 层是**硬编码散值**：127 处 `.fontSize(`、字号 **18 个不同值**
 *   （含 9.5/10.5/11.5/12.5/13.5 这些不落在任何刻度上的半档）、间距 20 个值、圆角 5 个值。
 *   后果是同类角色在不同页面长得不一样，而 v1-design §8 明写「UI 层必须读唯一真源」——
 *   文档要求已经有了，代码没做到。**没有一把被共同遵守的尺子**，不是某个控件错了。
 *
 * 规则：
 *   - 所有字号只能取 `RR_FS_*`，所有间距只能取 `RR_SP_*`，所有圆角只能取 `RR_RADIUS_*`
 *   - 需要新值时先问"现有档位够不够"，不够才在这里加一档，并同步回 v1-design.md
 *
 * 单位说明：
 *   - 字号单位 **fp**（`.fontSize(数字)` 的默认单位），随系统字体大小缩放
 *   - 间距 / 圆角单位 **vp**（布局尺寸），不随字号缩放
 *   - 两者不要混用
 *
 * ⚠️ **颜色不在本文件**：四套主题（深/浅/纸/绿）的色板是**运行时切换**的
 *   （`common/Theme.ets` 的 `paletteOf()`，并有 4 条对比度单测守 AA/AAA），
 *   既不走资源也不走静态常量。本文件只管字号/间距/圆角三项**静态量**。
 *
 * ⚠️ **本文件不覆盖正文排版档位**（字号/行距/页边距 5 档）—— 那张表在 v1-design §8，
 *   由 `engine` 层的排版代码自己持有，两者互不相干（UI 尺子不支配正文尺子）。
 */

/* ==================================================================
 * 字阶（fp）—— 8 档，按语义命名而非按大小命名
 * ================================================================== */

/** 页面主标题（书架「书架」、设置「设置」） */
export const RR_FS_DISPLAY: number = 22;

/** 书名 / 大卡片标题 */
export const RR_FS_TITLE: number = 20;

/** 小节标题 / 列表主行 */
export const RR_FS_HEADING: number = 16;

/** 正文说明 / 设置项 */
export const RR_FS_BODY: number = 14;

/** 按钮文字 / chip / 强调文本 */
export const RR_FS_LABEL: number = 13;

/** 次级说明 / 时间戳 */
export const RR_FS_META: number = 12;

/**
 * **数码专用**（页码、进度百分比、章节序号、时间）
 * ⚠️ 别拿它当普通小字用 —— v1-design §8「字体三分工」：点阵/等宽只给数码。
 */
export const RR_FS_DIGIT: number = 10;

/** 极小标签（如书架底部的 `LOCAL ONLY`） */
export const RR_FS_MICRO: number = 9;

/* ==================================================================
 * 间距阶（vp）—— 2 的倍数
 * ================================================================== */

/** 极窄内边距（角标一类） */
export const RR_SP_XS: number = 2;

/** 窄间距 */
export const RR_SP_SM: number = 4;

/** 小间距 */
export const RR_SP_MD: number = 6;

/** 组件内默认间距 */
export const RR_SP_LG: number = 8;

/** 相关内容之间的间距 */
export const RR_SP_XL: number = 10;

/** 分组之间的间距 */
export const RR_SP_2XL: number = 12;

/** 区块之间的间距 */
export const RR_SP_3XL: number = 16;

/** **页面左右安全边距（全项目统一 20）** */
export const RR_SP_4XL: number = 20;

/** 大区块间距 */
export const RR_SP_5XL: number = 24;

/** 特大分组间距 */
export const RR_SP_6XL: number = 32;

/** 空状态上方的大留白 */
export const RR_SP_VOID: number = 60;

/** 页面顶部整体下沉 */
export const RR_SP_TOP: number = 80;

/* ==================================================================
 * 圆角阶（vp）
 * ================================================================== */

/**
 * ⚠️ 2026-10-10 原生化：圆角改为**华为官方五档**（《圆角参数-视觉风格-手机/折叠屏/平板》：
 * 通用超小 4vp / 小 8vp / 中 12vp / 大 16vp / 超大 24vp）。
 * 旧值是 0 / 6 / 10 / 12 —— 6、10、0 都不落在官方档位上（Nothing 风的"零圆角更像书"），
 * 原生化后统一取官方刻度。
 */

/** **书封面**：官方超小圆角 4vp（原 0 直角是 Nothing 风决定，随原生化改为 4） */
export const RR_RADIUS_COVER: number = 4;

/** 小元素（缩略图、chip）—— 官方小圆角 8vp */
export const RR_RADIUS_SM: number = 8;

/** 输入框 / 内联控件 —— 官方中圆角 12vp */
export const RR_RADIUS_MD: number = 12;

/** **卡片 / 面板 / 浮层** —— 官方大圆角 16vp */
export const RR_RADIUS_CARD: number = 16;