{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // 设备类型命名差异坑：OpenHarmony SDK 里手机侧是 "default"（不是 "phone"）。
    // 用 "phone" 会报 00303060「多设备 syscap 交集为空」——因为找不到 phone 的 syscap 集合。
    // MVP 手机优先；将来正式出 HarmonyOS 包时如需 2in1/phone 命名再按产品调整。
    "deviceTypes": [
      "default",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 铁律 3「核心数据不联网」：**本应用不上传任何数据**。
    // 声明 INTERNET 只用于两件"用户可感知、且可自行拒绝"的事：
    //   ① 字体包下载（用户点「下载」才发起，见 common/FontCatalog.ets）
    //   ② 广告素材（M7，尚未接入）
    // 用途已在家族 findings §8（网络权限申请记录）登记。
    // 断网 / 用户在系统里掐掉联网权限 → 两者都静默缺席，阅读功能完全不受影响。
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:startIcon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}
