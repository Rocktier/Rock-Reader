{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // 设备类型命名差异坑：OpenHarmony SDK 里手机侧是 "default"（不是 "phone"）。
    // 用 "phone" 会报 00303060「多设备 syscap 交集为空」——因为找不到 phone 的 syscap 集合。
    // MVP 手机优先；将来正式出 HarmonyOS 包时如需 2in1/phone 命名再按产品调整。
    "deviceTypes": [
      "default",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // ⚠️ **本应用零联网：不申请任何权限**（2026-09-25 删掉最后一个 INTERNET）。
    //
    // 删得掉的原因：字体改为**内置**（宋体 2.91MB 进 rawfile，见 common/FontCatalog.ets），
    // 换字体不再需要下载 —— 联网这件事从此没有任何用途。
    //
    // 连带好处（这是删它的真正动机）：
    //   ① 隐私政策里"什么时候会联网"一节可以整体消失，政策变得极干净；
    //   ② AGC 隐私标签「是否涉及个人信息收集」= 否，毫无争议；
    //   ③ 工信部 APP 备案的前提是"从事互联网信息服务"—— 零联网下这个判定也不再有歧义；
    //   ④ 审核时权限清单为空，是最容易被放过的形态。
    //
    // 将来若要重新联网（例如接入华为广告变现 —— 官方要求 INTERNET + APP_TRACKING_CONSENT），
    // 在这里加回即可；注意那会让隐私标签从"不涉及"变成"涉及"（OAID），是一次大变更。
    // 权限申请记录见家族 findings §8。
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:startIcon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        // 显式写启动模式：默认是 singleton，但写明白能避免后人误判"没配=多实例"
        "launchType": "singleton",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            // **「用其他应用打开」**：声明了它，RockReader 才会出现在系统文件管理器、
            // 微信/QQ/浏览器里长按一本书后的打开方式列表中。
            //
            // 为什么必须有第二条路：系统 picker 对 `.mobi` / `.azw3` 这类它没登记过的后缀
            // **不显示**（2026-09-22 实测）。这条路不依赖系统认识后缀，是导入的保底入口，
            // 也符合国内阅读器的习惯（微信读书、掌阅都这么做）。
            "actions": [
              "ohos.want.action.viewData"
            ],
            // ⚠️ **绝对不要写 entities 字段**。
            // 实测（2026-09-22，BMS 日志）：系统文件管理器发来的 want 里 `entities` 是**空数组**，
            // 而只要声明了 entities 就变成"必须项" → 一个都匹配不上 → 系统弹「暂无可用打开方式」。
            // 这是本项目踩过的坑：写了 entity.system.default 反而把功能写没了。
            // ⚠️ 2026-09-23 对照实验（Pura 90 Pro 模拟器 / HarmonyOS 7.0(26)）完整矩阵：
            //   | want 形态                                    | Rock阅读 命中 |
            //   |----------------------------------------------|---------------|
            //   | 纯 type（-t text/plain，无 uri）              | ✅ 列表第一位  |
            //   | file:// 无/有 host，无 type                   | ❌            |
            //   | file:// 无/有 host + type                     | ❌            |
            //   uris 先后试过：scheme:file±type / 纯 type / 纯 scheme / 不写 uris / ±utd —— 带 uri 的 want 一次都没命中。
            //   列表里出现的文件预览/日历都是**系统 default-app 机制**进的（日历 skills 全空也能进），不是隐式匹配。
            //   → 结论：这台**模拟器镜像**上「其他应用打开」不收录三方 debug 应用的隐式匹配（或 ERMS 过滤）；
            //     **纯 type 场景（微信/QQ 分享文件）我们能进列表**，这条链路已验证可用。
            //   → 最终采用**官方文档配方**（scheme:file + type），真机上微信读书等三方应用能出现在
            //     文件管理器，说明真机行为不同；留待真机复核（device-test.md）。
            //   - utd 不要写（写了 general.plain-text 同样不命中）
            "uris": [
              {
                "scheme": "file",
                "type": "text/plain"
              },
              {
                "scheme": "file",
                "type": "application/epub+zip"
              },
              {
                "scheme": "file",
                "type": "application/octet-stream"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}
