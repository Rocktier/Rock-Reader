{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // 设备类型命名差异坑：OpenHarmony SDK 里手机侧是 "default"（不是 "phone"）。
    // 用 "phone" 会报 00303060「多设备 syscap 交集为空」——因为找不到 phone 的 syscap 集合。
    // MVP 手机优先；将来正式出 HarmonyOS 包时如需 2in1/phone 命名再按产品调整。
    "deviceTypes": [
      "default",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 铁律 3「核心数据不联网」：**本应用不上传任何数据**。
    // 声明 INTERNET 只用于两件"用户可感知、且可自行拒绝"的事：
    //   ① 字体包下载（用户点「下载」才发起，见 common/FontCatalog.ets）
    //   ② 广告素材（M7，尚未接入）
    // 用途已在家族 findings §8（网络权限申请记录）登记。
    // 断网 / 用户在系统里掐掉联网权限 → 两者都静默缺席，阅读功能完全不受影响。
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:startIcon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        // 显式写启动模式：默认是 singleton，但写明白能避免后人误判"没配=多实例"
        "launchType": "singleton",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            // **「用其他应用打开」**：声明了它，RockReader 才会出现在系统文件管理器、
            // 微信/QQ/浏览器里长按一本书后的打开方式列表中。
            //
            // 为什么必须有第二条路：系统 picker 对 `.mobi` / `.azw3` 这类它没登记过的后缀
            // **不显示**（2026-09-22 实测）。这条路不依赖系统认识后缀，是导入的保底入口，
            // 也符合国内阅读器的习惯（微信读书、掌阅都这么做）。
            "actions": [
              "ohos.want.action.viewData"
            ],
            "entities": [
              "entity.system.default"
            ],
            "uris": [
              {
                // 用通配而不是逐个列 mime：mobi / azw3 没有标准 MIME/UTD，
                // 写具体类型就等于把它们排除掉。选中不支持的文件时由导入逻辑明确提示。
                "scheme": "file",
                "type": "*/*"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}
